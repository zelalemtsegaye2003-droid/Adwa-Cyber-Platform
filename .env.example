# ── Adwa Cyber — environment configuration ─────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# SQLite database file (Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# REQUIRED — 64+ chars of entropy. Signs JWTs (HS256) and derives the
# AES-256-GCM key that encrypts TOTP secrets at rest. Rotating it invalidates
# all sessions and MFA secrets.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# OPTIONAL — Sign in with Google (OAuth 2.0 / OIDC).
# Callback URL to register in Google Cloud Console:
#   {origin}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL — external captcha providers (built-in SVG captcha is used when unset)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
